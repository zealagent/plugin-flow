{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noImplicitAny": false,
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "scripts/**/*.mjs",
    "scripts/**/*.ts",
    "packages/*/scripts/**/*.mjs",
    "packages/*/tests/**/*.mjs",
    "packages/dsh/index.js",
    "packages/dsh/client.js"
  ]
}
